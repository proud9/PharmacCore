{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "parallax-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "parallax-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "COOKIE_SECURE=false npx next start -p 3100"
      ],
      "port": 3100
    },
    {
      "name": "parallax-test",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/serve-test.ts",
        "workflow"
      ],
      "port": 3200
    }
  ]
}
