generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  role           String          @default("SALES")
  active         Boolean         @default(true)
  lastLoginAt    DateTime?
  institutionId  String?
  institution    Institution?    @relation(fields: [institutionId], references: [id])
  /// MANUFACTURER accounts belong to one Supplier (one account per manufacturer).
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  stockTakes     StockTake[]
  auditLogs      AuditLog[]
  prescriptions  Prescription[]
  purchaseOrders PurchaseOrder[]
  consignments   Consignment[]   @relation("RequestedBy")
  quotedOrders   Consignment[]   @relation("QuotedBy")
}

model Patient {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  gender        String?
  phone         String?
  email         String?
  address       String?
  allergies     String?
  insurance     String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]
  sales         Sale[]

  @@index([lastName, firstName])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contact        String?
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime        @default(now())
  products       Product[]
  purchaseOrders PurchaseOrder[]
  users          User[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id                String              @id @default(cuid())
  sku               String              @unique
  barcode           String?
  name              String
  genericName       String?
  form              String?
  strength          String?
  manufacturer      String?
  categoryId        String?
  category          Category?           @relation(fields: [categoryId], references: [id])
  supplierId        String?
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  unit              String              @default("pack")
  sellingPrice      Float
  costPrice         Float
  reorderLevel      Int                 @default(20)
  reorderQty        Int                 @default(50)
  requiresRx        Boolean             @default(false)
  controlled        Boolean             @default(false)
  taxRate           Float               @default(0)
  kind              String              @default("MEDICINE")
  wholesalePrice    Float?
  categoryNo        String?
  active            Boolean             @default(true)
  deletedAt         DateTime?
  deleteReason      String?
  deletedByName     String?
  purgedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  batches           Batch[]
  saleItems         SaleItem[]
  purchaseItems     PurchaseOrderItem[]
  stockTakeItems    StockTakeItem[]
  prescriptionItems PrescriptionItem[]
  consignmentItems  ConsignmentItem[]
  intakes           StockIntake[]

  @@index([active, sku])
  @@index([active, name])
  @@index([deletedAt])
}

model Batch {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  lotNumber  String
  expiryDate DateTime
  quantity   Int
  receivedAt DateTime @default(now())

  @@index([productId, quantity])
  @@index([quantity, expiryDate])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  reference      String              @unique
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  /// See lib/purchasing.ts: SENT → QUOTED → ACCEPTED → DISPATCHED → RECEIVED, or DECLINED / CANCELLED.
  status         String              @default("SENT")
  notes          String?
  createdAt      DateTime            @default(now())
  receivedAt     DateTime?
  items          PurchaseOrderItem[]
  deliveryNoteNo String?
  intakes        StockIntake[]
  events         PurchaseOrderEvent[]
  // Manufacturer's quotation
  quotedAmount    Float?
  taxRate         Float              @default(0)
  readyOn         DateTime?
  validUntil      DateTime?
  quotedAt        DateTime?
  supplierMessage String?
  terms           String?
  // Manufacturer's invoice; finance records what has been paid
  invoiceNo       String?
  invoicedAt      DateTime?
  dueOn           DateTime?
  amountPaid      Float              @default(0)
  // Manufacturer's dispatch
  dispatchedAt    DateTime?
  deliveryMethod  String?

  @@index([createdAt])
  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([dueOn])
}

model PurchaseOrderEvent {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  message   String?
  actorName String?
  createdAt DateTime      @default(now())

  @@index([orderId, createdAt])
}

model PurchaseOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  /// Expected cost when ordered; replaced by the manufacturer's quoted price.
  unitCost  Float         @default(0)
  /// Quantity on the manufacturer's delivery note.
  qtyDispatched Int?

  @@index([orderId])
  @@index([productId])
}

model Prescription {
  id           String             @id @default(cuid())
  rxNumber     String             @unique
  patientId    String
  patient      Patient            @relation(fields: [patientId], references: [id])
  pharmacistId String?
  pharmacist   User?              @relation(fields: [pharmacistId], references: [id])
  prescriber   String
  clinic       String?
  status       String             @default("PENDING")
  notes        String?
  createdAt    DateTime           @default(now())
  dispensedAt  DateTime?
  items        PrescriptionItem[]

  @@index([status, createdAt])
  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int
  dosage         String?
  instructions   String?

  @@index([prescriptionId])
  @@index([productId])
}

model Sale {
  id        String     @id @default(cuid())
  invoiceNo String     @unique
  cashierId String
  cashier   User       @relation(fields: [cashierId], references: [id])
  patientId String?
  patient   Patient?   @relation(fields: [patientId], references: [id])
  subtotal  Float
  tax       Float
  discount  Float      @default(0)
  total     Float
  payment   String     @default("CASH")
  createdAt DateTime   @default(now())
  items     SaleItem[]

  @@index([createdAt])
  @@index([patientId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  total     Float

  @@index([saleId])
  @@index([productId])
}

model StockTake {
  id          String          @id @default(cuid())
  reference   String          @unique
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  status      String          @default("IN_PROGRESS")
  notes       String?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  items       StockTakeItem[]

  @@index([startedAt])
}

model StockTakeItem {
  id          String    @id @default(cuid())
  stockTakeId String
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  systemQty   Int
  countedQty  Int
  variance    Int
  unitPrice   Float     @default(0)

  @@index([stockTakeId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Pharmacy {
  id            String  @id @default("main")
  name          String
  license       String?
  phone         String?
  email         String?
  address       String?
  website       String?
  tpin          String?
  currency      String  @default("ZMW")
  bankName      String?
  accountName   String?
  accountNumber String?
  bankBranch    String?
  swiftCode     String?
  logoPath      String?
}

model Institution {
  id        String        @id @default(cuid())
  name      String
  kind      String
  license   String?
  contact   String?
  phone     String?
  email     String?
  address   String?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  users     User[]
  orders    Consignment[]
}

model Consignment {
  id              String             @id @default(cuid())
  reference       String             @unique
  institutionId   String
  institution     Institution        @relation(fields: [institutionId], references: [id])
  requestedById   String
  requestedBy     User               @relation("RequestedBy", fields: [requestedById], references: [id])
  quotedById      String?
  quotedBy        User?              @relation("QuotedBy", fields: [quotedById], references: [id])
  status          String             @default("REQUESTED")
  notes           String?
  adminMessage    String?
  quotedAmount    Float?
  taxRate         Float              @default(0)
  readyOn         DateTime?
  validUntil      DateTime?
  dueOn           DateTime?
  amountPaid      Float              @default(0)
  invoiceNo       String?            @unique
  deliveryNoteNo  String?            @unique
  terms           String?
  deliveryMethod  String?
  vehicleDriver   String?
  dispatchFrom    String?
  deliveryNotes   String?
  invoicedAt      DateTime?
  deliveryAddress String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  quotedAt        DateTime?
  items           ConsignmentItem[]
  events          ConsignmentEvent[]

  @@index([institutionId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([dueOn])
}

model ConsignmentItem {
  id            String      @id @default(cuid())
  consignmentId String
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Float?
  qtyDelivered  Int?
  remarks       String?
  notes         String?

  @@index([consignmentId])
  @@index([productId])
}

model ConsignmentEvent {
  id            String      @id @default(cuid())
  consignmentId String
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  status        String
  message       String?
  actorName     String?
  createdAt     DateTime    @default(now())

  @@index([consignmentId])
}

/// A delivered supplier line waiting in Inventory for its expiry, price and
/// other details. Stock is only added once the details are entered (status DONE).
model StockIntake {
  id              String         @id @default(cuid())
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  deliveryNoteNo  String
  supplierName    String?
  quantity        Int
  unitCost        Float          @default(0)
  status          String         @default("PENDING")
  lotNumber       String?
  expiryDate      DateTime?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  @@index([status, createdAt])
  @@index([productId])
}

/// "Request a demo" submissions from the public landing page. Administrators see them under Demo requests.
model DemoRequest {
  id            String    @id @default(cuid())
  name          String
  company       String
  phone         String
  email         String
  notes         String?
  createdAt     DateTime  @default(now())
  contactedAt   DateTime?
  contactedById String?

  @@index([createdAt])
}
