generator client {
  provider = "prisma-client-js"
}

/// The app connects as a non-owner role (DATABASE_URL) so row-level security applies.
/// Schema changes and prisma/rls.sql run as the owner (DIRECT_URL).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform tables: no tenant. Readable by the Parallax team's connection role.
// ─────────────────────────────────────────────────────────────────────────────

/// A business on Parallax. kind: MANUFACTURER | WHOLESALER | RETAILER | CLIENT (lib/capabilities.ts).
model Organization {
  id                  String    @id @default(cuid())
  kind                String
  name                String
  town                String?
  address             String?
  phone               String?
  email               String?
  website             String?
  logoPath            String?
  /// Shown in the directory so other businesses can find it and ask to connect.
  listed              Boolean   @default(true)
  /// PREPAY | ON_DELIVERY | CREDIT (lib/trade.ts)
  defaultPaymentTerms String    @default("ON_DELIVERY")
  creditDays          Int       @default(30)
  currency            String    @default("ZMW")
  /// ACTIVE | SUSPENDED | DELETED
  status              String    @default("ACTIVE")
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Encrypted at rest (lib/crypto.ts)
  licenceNo           String?
  tpin                String?
  bankName            String?
  accountName         String?
  accountNumber       String?
  bankBranch          String?
  swiftCode           String?

  users        User[]
  subscription Subscription?

  @@index([kind, status, name])
  @@index([status, createdAt])
}

/// role: ADMIN (Parallax team, orgId null) or the organisation's kind.
model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  name               String
  passwordHash       String
  role               String
  orgId              String?
  org                Organization? @relation(fields: [orgId], references: [id])
  active             Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  /// Bumped on password reset, deactivation or "sign out everywhere": older session cookies stop working.
  sessionVersion     Int           @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([orgId])
  @@index([role, createdAt])
}

/// One per paying organisation (not clients). Status is computed in lib/subscription.ts.
model Subscription {
  id          String                @id @default(cuid())
  orgId       String                @unique
  org         Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan        String                @default("STANDARD")
  trialEndsAt DateTime?
  periodEnd   DateTime
  /// Agreed price per month in ZMW, set by the team. Null until agreed.
  monthlyFee  Float?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  payments    SubscriptionPayment[]

  @@index([periodEnd])
}

/// One subscription payment and its receipt. Recorded by the team today (source MANUAL); a card or
/// mobile-money provider will add rows itself later (source ONLINE, provider + providerRef, status
/// PENDING until confirmed). Only PAID rows count. Businesses can read their own rows (RLS), never write.
model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  orgId          String
  orgName        String
  receiptNo      String       @unique
  amount         Float
  paidOn         DateTime
  months         Int          @default(1)
  periodStart    DateTime
  periodEnd      DateTime
  method         String       @default("BANK_TRANSFER")
  source         String       @default("MANUAL")
  status         String       @default("PAID")
  provider       String?
  providerRef    String?
  reference      String?
  recordedById   String?
  recordedByName String?
  createdAt      DateTime     @default(now())

  @@unique([provider, providerRef])
  @@index([orgId, paidOn])
  @@index([paidOn])
  @@index([subscriptionId, paidOn])
}

/// A message from the Parallax team. audience: ALL | KIND (kind set) | ORG (orgId set).
model Announcement {
  id          String             @id @default(cuid())
  audience    String
  kind        String?
  orgId       String?
  title       String
  body        String
  createdById String?
  createdAt   DateTime           @default(now())
  reads       AnnouncementRead[]

  @@index([createdAt])
  @@index([audience, kind])
  @@index([orgId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

/// Every action by the Parallax team.
model PlatformAudit {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  orgId     String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orgId, createdAt])
}

/// "Request a demo" submissions from the public landing page.
model DemoRequest {
  id            String    @id @default(cuid())
  name          String
  company       String
  phone         String
  email         String
  notes         String?
  createdAt     DateTime  @default(now())
  contactedAt   DateTime?
  contactedById String?

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant tables: every row carries orgId; row-level security limits each business
// to its own rows (prisma/rls.sql). Access them only through lib/tenant.ts.
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  orgId    String
  name     String
  products Product[]

  @@unique([orgId, name])
}

model Product {
  id             String    @id @default(cuid())
  orgId          String
  sku            String
  barcode        String?
  name           String
  genericName    String?
  form           String?
  strength       String?
  manufacturer   String?
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  unit           String    @default("pack")
  sellingPrice   Float     @default(0)
  costPrice      Float     @default(0)
  reorderLevel   Int       @default(20)
  reorderQty     Int       @default(50)
  requiresRx     Boolean   @default(false)
  controlled     Boolean   @default(false)
  taxRate        Float     @default(0)
  kind           String    @default("MEDICINE")
  categoryNo     String?
  /// In the item list connected buyers can see (names only, never prices or stock).
  offered        Boolean   @default(true)
  active         Boolean   @default(true)
  deletedAt      DateTime?
  deleteReason   String?
  deletedByName  String?
  purgedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batches           Batch[]
  saleItems         SaleItem[]
  stockTakeItems    StockTakeItem[]
  prescriptionItems PrescriptionItem[]
  intakes           StockIntake[]

  @@unique([orgId, sku])
  @@index([orgId, active, name])
  @@index([orgId, deletedAt])
  @@index([orgId, active, offered, name])
}

model Batch {
  id         String   @id @default(cuid())
  orgId      String
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  lotNumber  String
  expiryDate DateTime
  quantity   Int
  receivedAt DateTime @default(now())

  @@index([productId, quantity])
  @@index([orgId, quantity, expiryDate])
}

/// A delivered line waiting in Inventory for its expiry and other details. Stock is only
/// added once the details are entered (status DONE).
model StockIntake {
  id             String      @id @default(cuid())
  orgId          String
  tradeOrderId   String?
  tradeOrder     TradeOrder? @relation(fields: [tradeOrderId], references: [id])
  /// Null until matched to (or created as) one of this business's items.
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id])
  /// The supplier's description of the line, for matching.
  itemName       String
  itemStrength   String?
  itemForm       String?
  itemUnit       String?
  sellerProductId String?
  deliveryNoteNo String
  supplierName   String?
  quantity       Int
  unitCost       Float       @default(0)
  status         String      @default("PENDING")
  lotNumber      String?
  expiryDate     DateTime?
  createdAt      DateTime    @default(now())
  completedAt    DateTime?

  @@index([orgId, status, createdAt])
  @@index([productId])
}

model StockTake {
  id          String          @id @default(cuid())
  orgId       String
  reference   String
  userId      String
  userName    String
  status      String          @default("IN_PROGRESS")
  notes       String?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  items       StockTakeItem[]

  @@unique([orgId, reference])
  @@index([orgId, startedAt])
}

model StockTakeItem {
  id          String    @id @default(cuid())
  orgId       String
  stockTakeId String
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  systemQty   Int
  countedQty  Int
  variance    Int
  unitPrice   Float     @default(0)

  @@index([stockTakeId])
  @@index([productId])
}

// Retail counter (retailers)

model Patient {
  id            String         @id @default(cuid())
  orgId         String
  firstName     String
  lastName      String
  gender        String?
  // Encrypted at rest
  dateOfBirth   String?
  phone         String?
  email         String?
  address       String?
  allergies     String?
  insurance     String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]
  sales         Sale[]

  @@index([orgId, lastName, firstName])
}

model Prescription {
  id             String             @id @default(cuid())
  orgId          String
  rxNumber       String
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  dispensedById  String?
  dispensedBy    String?
  prescriber     String
  clinic         String?
  status         String             @default("PENDING")
  notes          String?
  createdAt      DateTime           @default(now())
  dispensedAt    DateTime?
  items          PrescriptionItem[]

  @@unique([orgId, rxNumber])
  @@index([orgId, status, createdAt])
  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  orgId          String
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int
  dosage         String?
  instructions   String?

  @@index([prescriptionId])
  @@index([productId])
}

model Sale {
  id         String     @id @default(cuid())
  orgId      String
  invoiceNo  String
  cashierId  String
  cashierName String
  patientId  String?
  patient    Patient?   @relation(fields: [patientId], references: [id])
  subtotal   Float
  tax        Float
  discount   Float      @default(0)
  total      Float
  payment    String     @default("CASH")
  createdAt  DateTime   @default(now())
  items      SaleItem[]

  @@unique([orgId, invoiceNo])
  @@index([orgId, createdAt])
  @@index([patientId])
}

model SaleItem {
  id        String  @id @default(cuid())
  orgId     String
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  total     Float

  @@index([saleId])
  @@index([productId])
}

// Every business

/// A business's own activity log. userName is kept so entries survive a deleted login.
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

/// A business's PRIVATE list of counterparties for documents (customers or suppliers that may
/// not be on Parallax). linkedOrgId is set when the contact is a business on Parallax.
model Contact {
  id          String   @id @default(cuid())
  orgId       String
  /// SUPPLIER | CUSTOMER
  role        String
  /// MANUFACTURER | WHOLESALER | RETAILER | CLIENT
  kind        String
  name        String
  address     String?
  town        String?
  linkedOrgId String?
  // Encrypted at rest
  phone       String?
  email       String?
  tpin        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, role, name])
}

/// Business events for one organisation (the notification bell).
model Notification {
  id        String    @id @default(cuid())
  orgId     String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orgId, readAt, createdAt])
}

/// Which of the buyer's items a supplier's item becomes, so later deliveries match automatically.
model ProductLink {
  id              String   @id @default(cuid())
  orgId           String
  sellerOrgId     String
  sellerProductId String
  productId       String
  createdAt       DateTime @default(now())

  @@unique([orgId, sellerProductId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared trade tables: visible to exactly the two businesses involved.
// ─────────────────────────────────────────────────────────────────────────────

/// A trading connection. Either side asks; the other accepts.
model TradeLink {
  id               String    @id @default(cuid())
  sellerOrgId      String
  buyerOrgId       String
  /// PENDING | ACTIVE | DECLINED | ENDED
  status           String    @default("PENDING")
  requestedByOrgId String
  /// Overrides the seller's default for this buyer.
  paymentTerms     String?
  creditDays       Int?
  createdAt        DateTime  @default(now())
  respondedAt      DateTime?

  @@unique([sellerOrgId, buyerOrgId])
  @@index([buyerOrgId, status])
  @@index([sellerOrgId, status])
}

/// One order between a seller and a buyer, from inquiry to closed. One side may be off Parallax
/// (channel OFFLINE): then that side is a Contact of the business that created the order.
model TradeOrder {
  id               String   @id @default(cuid())
  sellerOrgId      String?
  buyerOrgId       String?
  sellerContactId  String?
  buyerContactId   String?
  createdByOrgId   String
  /// ONLINE | OFFLINE
  channel          String   @default("ONLINE")
  sellerName       String
  buyerName        String
  /// See lib/trade.ts
  status           String   @default("INQUIRY")
  paymentTerms     String   @default("ON_DELIVERY")
  creditDays       Int      @default(30)

  inquiryNo        String
  quoteNo          String?
  poNumber         String?
  invoiceNo        String?
  deliveryNoteNo   String?

  buyerMessage     String?
  deliveryAddress  String?
  // Quotation
  quotedAmount     Float?
  taxRate          Float    @default(0)
  readyOn          DateTime?
  validUntil       DateTime?
  terms            String?
  sellerMessage    String?
  // Invoice
  dueOn            DateTime?
  amountPaid       Float    @default(0)
  // Dispatch
  deliveryMethod   String?
  vehicleDriver    String?
  dispatchFrom     String?
  deliveryNotes    String?
  // Private to each side (encrypted)
  sellerNotes      String?
  buyerNotes       String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  quotedAt         DateTime?
  orderedAt        DateTime?
  invoicedAt       DateTime?
  dispatchedAt     DateTime?
  receivedAt       DateTime?
  closedAt         DateTime?

  items    TradeOrderItem[]
  events   TradeOrderEvent[]
  payments TradePayment[]
  intakes  StockIntake[]

  @@unique([buyerOrgId, inquiryNo])
  @@index([sellerOrgId, status, createdAt])
  @@index([buyerOrgId, status, createdAt])
  @@index([sellerOrgId, dueOn])
  @@index([buyerOrgId, dueOn])
}

model TradeOrderItem {
  id              String     @id @default(cuid())
  orderId         String
  order           TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name            String
  strength        String?
  form            String?
  unit            String?
  quantity        Int
  /// The seller's item (seller only).
  sellerProductId String?
  /// The buyer's item (buyer only).
  buyerProductId  String?
  unitPrice       Float?
  qtyDispatched   Int?
  qtyReceived     Int?
  remarks         String?

  @@index([orderId])
}

model TradeOrderEvent {
  id         String     @id @default(cuid())
  orderId    String
  order      TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     String
  message    String?
  actorOrgId String?
  actorName  String?
  createdAt  DateTime   @default(now())

  @@index([orderId, createdAt])
}

model TradePayment {
  id         String     @id @default(cuid())
  orderId    String
  order      TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Float
  method     String
  paidOn     DateTime
  reference  String?
  recordedBy String?
  createdAt  DateTime   @default(now())

  @@index([orderId])
}
