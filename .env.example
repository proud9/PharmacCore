# PostgreSQL. Three connections to the same database:
# - DIRECT_URL: the database owner. Used only for schema changes and prisma/rls.sql (npm run db:push).
# - DATABASE_URL: the app's own role. Not the owner, so row-level security applies to it.
# - ADMIN_DATABASE_URL: the Parallax team's screens. No access to any business's data tables.
# npm run db:push creates the two roles with the passwords given here.
DIRECT_URL="postgresql://YOUR_MAC_USER@localhost:5432/parallax"
DATABASE_URL="postgresql://parallax_app:choose-a-password@localhost:5432/parallax"
ADMIN_DATABASE_URL="postgresql://parallax_admin:choose-another-password@localhost:5432/parallax"

AUTH_SECRET="replace-with-a-long-random-string"

# Field encryption key: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and backed up: encrypted fields (bank details, TPIN, contact and patient details)
# cannot be read without it.
DATA_KEY="replace-with-32-random-bytes-base64"

# Production sign-in cookies are HTTPS-only. Set to "false" only to run `npm start` over plain HTTP on a trusted local network.
# COOKIE_SECURE="false"
